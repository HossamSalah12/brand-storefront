# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server only, NEVER prefix with NEXT_PUBLIC_, never import in client components
SUPABASE_SERVICE_ROLE_KEY=

# Used to protect the very first admin bootstrap step (see README)
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-long-random-string

# Optional — order confirmation emails via Resend (resend.com, free tier
# available). Leave blank to skip emails entirely; checkout works fine
# without them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com
